{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qrtoss",
  "main": "server/cloudflare/src/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["no_web_socket_compression"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "qrtoss.example", "custom_domain": true }],
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "CAPACITY", "class_name": "CapacityDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "CapacityDO"] }],
  "vars": {
    "PUBLIC_ORIGIN": "https://qrtoss.example",
    "MAX_ROOMS": "1000",
    "MAX_SOCKETS": "2200",
    "MAX_UNAUTHENTICATED_SOCKETS": "100",
    "MAX_SOCKETS_PER_IP": "60",
    "IPV6_PREFIX_LENGTH": "64",
    "LOG_LEVEL": "warn"
  },
  "observability": { "enabled": false }
}
