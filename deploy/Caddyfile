# Caddy obtains and renews HTTPS certificates for PUBLIC_ORIGIN.
# Access logging and payload capture are deliberately not enabled.
{$PUBLIC_ORIGIN} {
    reverse_proxy app:8080 {
        # Override untrusted forwarded headers at the public edge.
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
        transport http {
            read_timeout 90s
            write_timeout 90s
        }
    }
}
