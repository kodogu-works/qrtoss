# Copy to .env and replace with an HTTPS origin you control (no trailing slash).
# Its DNS must point to the Docker host, and ports 80/443 must be reachable.
PUBLIC_ORIGIN=https://qrtoss.example
QRTOSS_IMAGE=qrtoss:0.1.0

# Runtime capacities. Shared protocol constants are not configurable here.
MAX_ROOMS=1000
MAX_SOCKETS=2200
MAX_UNAUTHENTICATED_SOCKETS=100
MAX_SOCKETS_PER_IP=60

# Only the Caddy container's fixed address is trusted. If changing the subnet
# in compose.yaml, also change proxy.ipv4_address and this CIDR together.
TRUST_PROXY_CIDRS=172.30.0.2/32
LOG_LEVEL=warn

# Direct backend launches (Compose fixes these values itself).
HOST=0.0.0.0
PORT=8080
NODE_ENV=production
