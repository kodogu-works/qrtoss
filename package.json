{
  "name": "qrtoss",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "generate": "node scripts/generate-protocol.mjs",
    "check:generated": "node scripts/generate-protocol.mjs --check",
    "check": "tsc --noEmit && tsc --project server/cloudflare/tsconfig.json",
    "lint": "biome lint --error-on-warnings",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:unit": "node --import tsx --test tests/protocol/*.test.ts",
    "test:interop": "node --import tsx --test tests/interop/*.test.ts",
    "check:i18n": "node --import tsx scripts/check-i18n.mjs",
    "build": "npm run generate && vite build --config web/vite.config.ts && node scripts/copy-licenses.mjs && esbuild server/src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/main.js",
    "start": "node dist/server/main.js",
    "gen:protocol": "node scripts/generate-protocol.mjs",
    "typecheck": "tsc --noEmit && tsc --project server/cloudflare/tsconfig.json",
    "test:integration": "node --import tsx --test tests/relay/*.test.ts",
    "test:e2e": "playwright test",
    "notices": "node scripts/notices.mjs",
    "release:cli": "sh scripts/release-cli.sh",
    "format": "biome format --write",
    "format:check": "biome format",
    "build:web": "npm run generate && vite build --config web/vite.config.ts && node scripts/copy-licenses.mjs",
    "dev:cloudflare": "node scripts/cloudflare.mjs dev",
    "deploy:cloudflare": "node scripts/cloudflare.mjs deploy",
    "check:cloudflare": "node scripts/check-cloudflare.mjs",
    "test:cloudflare": "node scripts/cloudflare.mjs test"
  },
  "dependencies": {
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/workers-types": "5.20261117.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "miniflare": "5.20261117.0-beta",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.164.0"
  }
}
